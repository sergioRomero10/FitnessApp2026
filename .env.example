# Copia este archivo a ".env" y rellena los valores. ".env" está en .gitignore.

# Clave para firmar las cookies de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Usuario administrador de MongoDB (solo lo usa el contenedor de Mongo al crearse)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambia-esta-password-root

# Usuario con permisos solo sobre la base de datos de la app (lo usan web y pipeline).
# Usa solo letras y números en las contraseñas: van dentro de una URL (mongodb://usuario:pass@...)
MONGO_APP_USER=fitnessapp
MONGO_APP_PASSWORD=cambia-esta-password-app

# Login con Google (opcional). Si se dejan vacíos, solo aparece "Entrar como invitado".
# Crea credenciales nuevas en https://console.cloud.google.com/apis/credentials
# URI de redirección autorizada en local: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Modo demo: muestra el botón "Entrar como invitado" (ideal para el portfolio)
DEMO_MODE=true

# Nominatim (OpenStreetMap) exige identificar la app con un User-Agent con contacto
NOMINATIM_USER_AGENT="FitnessApp/2.0 (tu-email@ejemplo.com)"
